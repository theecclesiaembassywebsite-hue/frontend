{
  // Worker name — must match "frontend" from https://frontend.theecclesiaembassywebsite.workers.dev
  "name": "frontend",

  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],

  // Entry point produced by `@opennextjs/cloudflare` (`opennextjs-cloudflare build`).
  "main": ".open-next/worker.js",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Page + tag cache for ISR and on-demand revalidation (see open-next.config.ts).
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "2c11bc3484d14a849600dc52018f513b" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "e20aa19dfcc0472c87e7d448d02bc05e" }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
