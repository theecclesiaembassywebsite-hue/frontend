## Frontend Environment Variables\n\n# Backend API Base URL (dev fallback: http://localhost:4000/api)\nNEXT_PUBLIC_API_URL=http://localhost:4000/api\n\n# Paystack (Nigeria)\nNEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...\n\n# ReCAPTCHA (optional)\nNEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAA...\n\n# YouTube Data API v3 — enables reliable live detection and video listing for the livestream page.\n# Without this key, both routes automatically fall back to HTML/RSS scraping.\n# Get a key: console.cloud.google.com → APIs & Services → YouTube Data API v3\nYOUTUBE_API_KEY=

# Spotify Web API — powers recent episode cards on the audio archive page.
# Create an app at: developer.spotify.com/dashboard → copy Client ID and Client Secret.
# Uses Client Credentials flow (no user login required).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
