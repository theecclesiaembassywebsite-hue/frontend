## Frontend Environment Variables\n\n# Backend API Base URL (dev fallback: http://localhost:4000/api)\nNEXT_PUBLIC_API_URL=http://localhost:4000/api\n\n# Paystack (Nigeria)\nNEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...\n\n# ReCAPTCHA (optional)\nNEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAA...\n\n# YouTube Data API v3 — enables reliable live detection and video listing for the livestream page.\n# Without this key, both routes automatically fall back to HTML/RSS scraping.\n# Get a key: console.cloud.google.com → APIs & Services → YouTube Data API v3\nYOUTUBE_API_KEY=

# Spotify Web API — powers recent episode cards on the audio archive page.
# Create an app at: developer.spotify.com/dashboard → copy Client ID and Client Secret.
# Uses Client Credentials flow (no user login required).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Error tracking (Sentry) ---
# All optional. With no DSN the SDK never starts, every Sentry call is a no-op,
# and nothing leaves the box — so dev, CI and self-hosted deploys need no
# account. Events carry the user id and a scrubbed request; never a password,
# token, cookie, email, phone or query string (see lib/observability/scrub.ts).
#
# Sent to the browser, so it also gets added to the CSP connect-src allowlist
# in next.config.ts automatically.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: keeps server-side errors reporting to a DSN that is NOT shipped to
# visitors. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_DSN=
# Fraction of requests traced for performance, 0..1. Errors are always captured
# regardless of this.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Overrides the environment/release names on an event. Vercel's
# VERCEL_GIT_COMMIT_SHA is used for the release when unset.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# Source map upload, so production stack traces name real files and lines.
# Build-time only. Without SENTRY_AUTH_TOKEN the upload is skipped and the
# build still succeeds — it just ships minified traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
